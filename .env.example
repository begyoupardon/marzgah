# Copy to .env (Bun / Docker), or run `bun run cli init` to generate this for you.
# Full reference: README.md → Configuration. Never commit real values.

# --- Required -------------------------------------------------------------
# Public URL of the panel. Telegram needs https://.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 32`.
# Signs sessions AND encrypts stored secrets; changing it invalidates both.
BETTER_AUTH_SECRET=<generate-a-long-random-secret>

# Marzban (server-side only)
MARZBAN_BASE_URL=https://marzban.example.com
MARZBAN_USERNAME=<marzban-admin-username>
MARZBAN_PASSWORD=<marzban-admin-password>
# Same value goes in Marzban's .env as WEBHOOK_SECRET.
MARZBAN_WEBHOOK_SECRET=<generate-a-long-random-secret>

# --- First run -------------------------------------------------------------
# Email allowed to create the first admin from /login on an empty database.
# (`bun run cli create-admin` works without this.)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Optional --------------------------------------------------------------
# Public subscription origin when it differs from the Marzban API host:
# MARZBAN_SUBSCRIPTION_URL_PREFIX=https://sub.example.com
# SQLite file (Docker image uses /data/panel.db):
# DATABASE_PATH=./data/panel.db
# Automatic daily backups (Docker image uses /data/backups) and how many to keep:
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# Disable background jobs (sync, backups, Telegram). Run them on ONE instance only:
# SCHEDULER=off

# Telegram bot and payment-gateway credentials are NOT set here:
# admins enter them in the panel (stored encrypted).
