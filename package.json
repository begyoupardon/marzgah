{
  "name": "marzgah",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "node ./node_modules/@tanstack/router-cli/dist/esm/index.js generate",
    "build": "vite build",
    "preview": "bun run build && bun run start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write . && oxlint --fix",
    "check": "oxfmt --check .",
    "test": "bun test --isolate src cli",
    "e2e:server": "bun scripts/e2e-server.ts",
    "test:e2e": "playwright test",
    "test:watch": "bun test --isolate --watch src cli",
    "deploy": "bun run build:cf && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "dev:cf": "BUILD_TARGET=cloudflare vite dev --port 3000",
    "build:cf": "BUILD_TARGET=cloudflare vite build",
    "start": "bun run .output/server/index.mjs",
    "db:migrate": "bun run cli migrate",
    "cli": "bun run cli/index.ts",
    "build:cli": "bun scripts/build-cli.ts",
    "test:cli-package": "bun scripts/test-cli-package.ts",
    "pack:cli": "bun run build:cli && npm pack ./packages/cli"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clack/prompts": "^1.8.1",
    "@faker-js/faker": "^10.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "^1.13.6",
    "@orpc/json-schema": "^1.13.6",
    "@orpc/openapi": "^1.13.6",
    "@orpc/server": "^1.13.6",
    "@orpc/tanstack-query": "^1.13.6",
    "@orpc/zod": "^1.13.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.5.3",
    "citty": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "nitro": "^3.0.260903-beta",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.89.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "@tanstack/router-core": "1.171.34",
    "@tanstack/router-ssr-query-core": "1.169.3"
  }
}
