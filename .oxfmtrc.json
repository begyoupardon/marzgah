{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".output/**",
    "dist/**",
    ".wrangler/**",
    ".tanstack/**",
    "worker-configuration.d.ts",
    "src/routeTree.gen.ts",
    "drizzle/**"
  ]
}
